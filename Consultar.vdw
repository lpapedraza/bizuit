E\",\"rules\":[]},{\"class\":\"CustomCodePropertiesComponent\",\"events\":[{\"_apiName\":\"\",\"_formName\":\"\",\"_eventType\":4,\"_code\":\"\\r\\nconst validarFechas = async () =&gt; {\\r\\n  \\r\\n\\r\\n    const ctlFechaNacimiento = BizuitForm.controls['fechaNacimiento'];\\r\\n\\r\\n    try {\\r\\n        const vlNac = await ctlFechaNacimiento.value;\\r\\n\\r\\n        console.log('valor original:', vlNac);\\r\\n\\r\\n        if (!vlNac) return;\\r\\n\\r\\n        let fechaNac;\\r\\n\\r\\n        if (typeof vlNac === 'string' &amp;&amp; vlNac.includes('/')) {\\r\\n\\r\\n            const [day, month, year] = vlNac.split('/');\\r\\n\\r\\n            const isoFecha = `${year}-${month}-${day}T00:00:00`;\\r\\n\\r\\n            console.log('iso generado:', isoFecha);\\r\\n\\r\\n            fechaNac = new Date(isoFecha);\\r\\n\\r\\n        } else {\\r\\n            fechaNac = new Date(vlNac);\\r\\n        }\\r\\n\\r\\n        const hoy = new Date();\\r\\n\\r\\n        fechaNac.setHours(0, 0, 0, 0);\\r\\n        hoy.setHours(0, 0, 0, 0);\\r\\n\\r\\n        console.log('fecha parseada:', fechaNac);\\r\\n        console.log('hoy:', hoy);\\r\\n\\r\\n        if (fechaNac &gt; hoy) {\\r\\n            showAlert(\\r\\n                {\\r\\n                    icon:'error',\\r\\n                    title:'¡Error!',\\r\\n                    text: 'La fecha de nacimiento no puede ser futura',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                \\r\\n                }\\r\\n               \\r\\n            );\\r\\n            ctlFechaNacimiento.value = null;\\r\\n        }\\r\\n\\r\\n    } catch (error) {\\r\\n        console.error('Error en validación:', error);\\r\\n    }\\r\\n};\\r\\n\\r\\nvalidarFechas();\\r\\n\"}],\"focusOn\":null,\"basicEvent\":1,\"selectedSecondaryDatasources\":[],\"selectedSecondaryDatasource\":\"\",\"selectedColumnTrace\":0,\"executeValidation\":true,\"selectedSubForm\":\"\",\"subFormSize\":{\"width\":60,\"widthUnit\":\"percentage\"