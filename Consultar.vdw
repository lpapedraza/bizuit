":1}],\"layerIndex\":1}],\"layerIndex\":1},{\"name\":\"subform1\",\"component\":\"SubFormComponent\",\"x\":0,\"y\":0,\"rows\":0,\"cols\":0,\"props\":[{\"class\":\"BasicPropertiesComponent\",\"name\":\"subform1\",\"title\":\"PROPERTIES.BASIC.TITLE\",\"label\":\"subform1\",\"value\":\"\",\"tooltip\":\"\",\"tooltipPosition\":\"above\",\"font\":\"Quicksand\",\"align\":\"center-container\",\"fontWeight\":\"inherit\",\"fontColor\":\"#ffffff\",\"backgroundColor\":\"#FFFFFF\",\"fontSize\":12,\"enabled\":true,\"parentEnabled\":true,\"visible\":true,\"vertical\":false,\"fontEffectLineThrough\":false,\"fontEffectUnderline\":false,\"properties\":[\"fontColor\"],\"labelValue\":\"value\",\"layer\":1,\"validateOnHiddenControl\":false,\"isSubForm\":true,\"isMainForm\":false},{\"class\":\"SubFormsPropertiesComponent\",\"columns\":6,\"request\":[],\"response\":[],\"acceptButtonLabel\":\"Aceptar\",\"closeButtonLabel\":\"X\",\"acceptBackgroundColor\":\"primary\",\"closeBackgroundColor\":\"secondary\",\"buttonAlign\":\"LEFT\",\"buttonType\":\"mat-mini-fab\",\"acceptIcon\":\"\",\"cancelIcon\":\"close\",\"showAcceptButton\":true,\"showCloseButton\":true},{\"class\":\"CustomCodePropertiesComponent\",\"events\":[{\"_apiName\":\"\",\"_formName\":\"\",\"_eventType\":5,\"_code\":\"/*\\r\\nwindow.addEventListener('message', (event) =&gt; {\\r\\n    console.log('[DEBUG] Mensaje recibido:', {\\r\\n        origin: event.origin,\\r\\n        data: event.data,\\r\\n        source: event.source\\r\\n    });\\r\\n});\\r\\n*/window.__listenerAngularSubformBizuit = async function (event) {\\r\\n    try {\\r\\n        const data = parseData(event.data);\\r\\n\\r\\n        if (!data) return;\\r\\n\\r\\n        // Ignorar mensajes internos de Bizuit sin imprimirlos\\r\\n        if (data.callId &amp;&amp; data.type) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        const esMensajeAngular =\\r\\n            data.origen === APP_ORIGEN &amp;&amp;\\r\\n            (\\r\\n                data.action === 'aceptarSubForm' ||\\r\\n                data.action === 'cerrar' ||\\r\\n                data.action === 'diagnostico'\\r\\n            );\\r\\n\\r\\n        if (!esMensajeAngular) {\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        console.log('[BIZUIT SUBFORM] MENSAJE ANGULAR VÁLIDO:', data);\\r\\n\\r\\n        if (data.action === 'diagnostico') {\\r\\n            console.log('[BIZUIT SUBFORM] Diagnóstico recibido correctamente desde Angular');\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        if (window.__procesandoAngularSubformBizuit) {\\r\\n            console.warn('[BIZUIT SUBFORM] Mensaje duplicado ignorado');\\r\\n            return;\\r\\n        }\\r\\n\\r\\n        window.__procesandoAngularSubformBizuit = true;\\r\\n\\r\\n        const ctrlDatoExterno = C('DatoExterno');\\r\\n\\r\\n        if (ctrlDatoExterno &amp;&amp; data.miDato !== undefined &amp;&amp; data.miDato !== null) {\\r\\n            ctrlDatoExterno.value = data.miDato;\\r\\n            console.log('[BIZUIT SUBFORM] DatoExterno asignado:', data.miDato);\\r\\n        }\\r\\n\\r\\n        if (data.action === 'aceptarSubForm') {\\r\\n            await aceptarYCerrarSubformulario();\\r\\n        }\\r\\n\\r\\n        if (data.action === 'cerrar') {\\r\\n            await aceptarYCerrarSubformulario();\\r\\n        }\\r\\n\\r\\n    } catch (error) {\\r\\n        console.error('[BIZUIT SUBFORM] Error procesando mensaje Angular:', error);\\r\\n    } finally {\\r\\n        setTimeout(() =&gt; {\\r\\n            window.__procesandoAngularSubformBizuit = false;\\r\\n        }, 1000);\\r\\n    }\\r\\n};\"}],\"focusOn\":null,\"basicEvent\":6,\"selectedSecondaryDatasources\":[],\"selectedSecondaryDatasource\":\"\",\"selectedColumnTrace\":0,\"executeValidation\":false,\"selectedSubForm\":\"\",\"subFormSize\":{\"width\":60,\"widthUnit\":\"percentage\",\"height\":60,\"heightUnit\":\"percentage\"},\"addDocumentsToDataSource\":false,\"selectedDocumentControl\":\"\",\"modalType\":\"swal\",