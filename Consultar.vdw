      <Design>{"id":1047,"name":"verdata","controls":"[{\"name\":\"verdata\",\"component\":\"MainFormComponent\",\"x\":0,\"y\":0,\"rows\":0,\"cols\":0,\"props\":[{\"class\":\"BasicPropertiesComponent\",\"name\":\"verdata\",\"title\":\"PROPERTIES.BASIC.TITLE\",\"label\":\"verdata\",\"value\":\"\",\"tooltip\":\"\",\"tooltipPosition\":\"above\",\"font\":\"Quicksand\",\"align\":\"center-container\",\"fontWeight\":\"normal\",\"fontColor\":\"#000000\",\"backgroundColor\":\"#FFFFFF\",\"fontSize\":12,\"enabled\":true,\"parentEnabled\":true,\"visible\":true,\"vertical\":false,\"fontEffectLineThrough\":false,\"fontEffectUnderline\":false,\"properties\":[\"backgroundColor\"],\"labelValue\":\"value\",\"layer\":1,\"validateOnHiddenControl\":false,\"isSubForm\":false,\"isMainForm\":true},{\"class\":\"FormPropertiesComponent\",\"title\":\"PROPERTIES.FORM.TITLE\",\"showMessageOnSuccess\":true,\"messagesParametersOnSuccess\":[],\"messageOnSuccess\":\"La operación se completó con éxito.\",\"showMessageOnError\":true,\"messageOnError\":\"Ha ocurrido un error.\",\"closeOnSuccess\":true,\"controlType\":\"outline\",\"cols\":6,\"rowHeight\":70,\"themeUseDefaultSettings\":false,\"theme\":\"theme-blue\",\"modalType\":\"swal\",\"modalTitle\":\"\",\"modalUseOKButton\":true,\"modalUseTimer\":false,\"modalUseDefaultSettings\":true,\"modalTimeout\":0,\"useRaiseEventAsync\":false,\"processingWaitTime\":5,\"useOpenFormSettings\":false,\"openFormType\":\"DIALOG\",\"splitType\":\"NONE\",\"formSize\":\"ORIGINAL_SIZE\",\"showModalTitle\":true},{\"class\":\"CustomCodePropertiesComponent\",\"events\":[],\"focusOn\":null,\"basicEvent\":1,\"selectedSecondaryDatasources\":[],\"selectedSecondaryDatasource\":\"\",\"selectedColumnTrace\":0,\"executeValidation\":true,\"selectedSubForm\":\"\",\"subFormSize\":{\"width\":60,\"widthUnit\":\"percentage\",\"height\":60,\"heightUnit\":\"percentage\"},\"addDocumentsToDataSource\":false,\"selectedDocumentControl\":\"\",\"modalType\":\"swal\",\"modalTitle\":\"\",\"modalMessage\":\"\",\"modalUseOKButton\":true,\"modalUseTimer\":false,\"modalTimeout\":5,\"showMessageOnSuccess\":true,\"clearControlsAfterExecute\":false},{\"class\":\"CustomStylesPropertiesComponent\",\"cssCode\":\"/* =========================================================\\r\\n   BIZUIT / Angular Material - 55px FINAL (LIMPIO)\\r\\n   - Outline: placeholder centrado + label flotante ok\\r\\n   - Standard/Legacy (DatePicker/Textarea): forzar look outline\\r\\n   - Textarea: borde envuelve toda la altura\\r\\n   ========================================================= */\\r\\n\\r\\n:root{\\r\\n  --bz-field-h: 55px;\\r\\n\\r\\n  /* Outline real */\\r\\n  --bz-float-px: -16px;\\r\\n  --bz-label-scale: .75;\\r\\n\\r\\n  /* Fake outline (standard/legacy) */\\r\\n  --bz-outline-bg: #ffffff; /* o #eceeef */\\r\\n  --bz-outline-border: rgba(0,0,0,.12);\\r\\n  --bz-outline-radius: 4px;\\r\\n}\\r\\n\\r\\n/* Evitar recortes */\\r\\n.mat-form-field-wrapper,\\r\\n.mat-form-field-label-wrapper{\\r\\n  overflow: visible !important;\\r\\n}\\r\\n\\r\\n/* Base: altura para todos (los textarea standard luego se liberan a auto) */\\r\\n.mat-form-field-flex{\\r\\n  height: var(--bz-field-h) !important;\\r\\n  align-items: stretch !important;\\r\\n}\\r\\n\\r\\n.mat-form-field-infix{\\r\\n  height: var(--bz-field-h) !important;\\r\\n  padding: 0 !important;\\r\\n  border-top: 0 !important;\\r\\n  display: flex !important;\\r\\n  align-items: center !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   OUTLINE (inputs/select) - centrado\\r\\n   ========================================================= */\\r\\n\\r\\n/* Input centrado (vacío y con valor) */\\r\\n.mat-input-element:not(textarea){\\r\\n  height: var(--bz-field-h) !important;\\r\\n  line-height: var(--bz-field-h) !important;\\r\\n  padding: 0 12px !important;\\r\\n  margin: 0 !important;\\r\\n  box-sizing: border-box !important;\\r\\n}\\r\\n\\r\\n/* Select centrado */\\r\\n.mat-select-trigger{\\r\\n  height: var(--bz-field-h) !important;\\r\\n  display: flex !important;\\r\\n  align-items: center !important;\\r\\n  padding: 0 12px !important;\\r\\n  box-sizing: border-box !important;\\r\\n}\\r\\n.mat-select-value,\\r\\n.mat-select-placeholder{\\r\\n  display: flex !important;\\r\\n  align-items: center !important;\\r\\n  line-height: normal !important;\\r\\n}\\r\\n.mat-select-arrow-wrapper{\\r\\n  display: flex !important;\\r\\n  align-items: center !important;\\r\\n}\\r\\n\\r\\n/* Label centrado cuando NO flota (solo outline) */\\r\\n.mat-form-field-appearance-outline .mat-form-field-label-wrapper{\\r\\n  top: 50% !important;\\r\\n  transform: translateY(-50%) !important;\\r\\n}\\r\\n\\r\\n/* Label flotante (solo outline) */\\r\\n.mat-form-field-appearance-outline.mat-form-field-should-float .mat-form-field-label-wrapper{\\r\\n  top: 0 !important;\\r\\n  transform: none !important;\\r\\n}\\r\\n.mat-form-field-appearance-outline.mat-form-field-can-float.mat-form-field-should-float\\r\\n.mat-form-field-label{\\r\\n  transform: translateY(var(--bz-float-px)) scale(var(--bz-label-scale)) !important;\\r\\n}\\r\\n\\r\\n/* Datepicker/prefix/suffix centrados (para outline también) */\\r\\n.mat-form-field-prefix,\\r\\n.mat-form-field-suffix,\\r\\n.mat-datepicker-toggle{\\r\\n  height: var(--bz-field-h) !important;\\r\\n  display: flex !important;\\r\\n  align-items: center !important;\\r\\n}\\r\\n\\r\\n/* Textarea OUTLINE real (si existiera alguno) */\\r\\n.mat-form-field-appearance-outline textarea.mat-input-element{\\r\\n  min-height: var(--bz-field-h) !important;\\r\\n  height: auto !important;\\r\\n  padding: 18px 12px 10px 12px !important;\\r\\n  line-height: 1.4 !important;\\r\\n  box-sizing: border-box !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   STANDARD/LEGACY - FORZAR LOOK OUTLINE (DatePicker/Textarea)\\r\\n   ========================================================= */\\r\\n\\r\\n/* Quitar underline/ripple */\\r\\n.mat-form-field-appearance-standard .mat-form-field-underline,\\r\\n.mat-form-field-appearance-legacy  .mat-form-field-underline,\\r\\n.mat-form-field-appearance-standard .mat-form-field-ripple,\\r\\n.mat-form-field-appearance-legacy  .mat-form-field-ripple{\\r\\n  display: none !important;\\r\\n}\\r\\n\\r\\n/* Caja tipo outline */\\r\\n.mat-form-field-appearance-standard .mat-form-field-flex,\\r\\n.mat-form-field-appearance-legacy  .mat-form-field-flex{\\r\\n  background: var(--bz-outline-bg) !important;\\r\\n  border: 1px solid var(--bz-outline-border) !important;\\r\\n  border-radius: var(--bz-outline-radius) !important;\\r\\n  padding: 0 12px !important;\\r\\n  box-sizing: border-box !important;\\r\\n}\\r\\n\\r\\n/* Hover/focus Zurich (opcional) */\\r\\n.mat-form-field-appearance-standard:hover .mat-form-field-flex,\\r\\n.mat-form-field-appearance-legacy:hover  .mat-form-field-flex{\\r\\n  border-color: #2167ae !important;\\r\\n}\\r\\n.mat-form-field-appearance-standard.mat-focused .mat-form-field-flex,\\r\\n.mat-form-field-appearance-legacy.mat-focused  .mat-form-field-flex{\\r\\n  border-color: #2167ae !important;\\r\\n  box-shadow: 0 0 0 2px rgba(33,103,174,.12) !important;\\r\\n}\\r\\n\\r\\n/* Label sin fondo (evita “mancha” sobre el borde) */\\r\\n.mat-form-field-appearance-standard .mat-form-field-label,\\r\\n.mat-form-field-appearance-legacy  .mat-form-field-label{\\r\\n  background: transparent !important;\\r\\n  padding: 0 2px !important;\\r\\n}\\r\\n\\r\\n/* Label flotante (ajuste único) */\\r\\n.mat-form-field-appearance-standard.mat-form-field-should-float .mat-form-field-label,\\r\\n.mat-form-field-appearance-legacy.mat-form-field-should-float  .mat-form-field-label{\\r\\n  transform: translateY(-0.78em) scale(.75) !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   TEXTAREA en STANDARD/LEGACY: caja debe crecer (outline completo)\\r\\n   ========================================================= */\\r\\n\\r\\n/* Cuando hay textarea, permitir crecer el contenedor */\\r\\n.mat-form-field-appearance-standard.mat-form-field-type-mat-input .mat-form-field-flex,\\r\\n.mat-form-field-appearance-legacy.mat-form-field-type-mat-input  .mat-form-field-flex{\\r\\n  height: auto !important;\\r\\n  min-height: var(--bz-field-h) !important;\\r\\n  align-items: stretch !important;\\r\\n}\\r\\n\\r\\n/* Infix también auto */\\r\\n.mat-form-field-appearance-standard.mat-form-field-type-mat-input .mat-form-field-infix,\\r\\n.mat-form-field-appearance-legacy.mat-form-field-type-mat-input  .mat-form-field-infix{\\r\\n  height: auto !important;\\r\\n  min-height: var(--bz-field-h) !important;\\r\\n  align-items: stretch !important;\\r\\n}\\r\\n\\r\\n/* Textarea padding interno (usa padding horizontal del flex) */\\r\\n.mat-form-field-appearance-standard.mat-form-field-type-mat-input textarea.mat-input-element,\\r\\n.mat-form-field-appearance-legacy.mat-form-field-type-mat-input  textarea.mat-input-element{\\r\\n  height: auto !important;\\r\\n  min-height: var(--bz-field-h) !important;\\r\\n  padding: 18px 0 10px 0 !important;\\r\\n  line-height: 1.4 !important;\\r\\n  box-sizing: border-box !important;\\r\\n}\\r\\n\"}],\"children\":[{\"name\":\"txtPnumeroDocumento1\",\"component\":\"InputTextboxComponent\",\"x\":2,\"y\":2,\"rows\":1,\"cols\":1,\"props\":[{\"class\":\"BasicPropertiesComponent\",\"name\":\"txtPnumeroDocumento1\",\"title\":\"PROPERTIES.BASIC.TITLE\",\"label\":\"pnumeroDocumento\",\"value\":\"\",\"tooltip\":\"\",\"tooltipPosition\":\"above\",\"font\":\"Quicksand\",\"align\":\"center-container\",\"fontWeight\":\"inherit\",\"fontColor\":\"#000000\",\"backgroundColor\":\"#FFFFFF\",\"fontSize\":12,\"enabled\":true,\"parentEnabled\":true,\"visible\":true,\"vertical\":false,\"fontEffectLineThrough\":false,\"fontEffectUnderline\":false,\"properties\":[\"label\",\"value\",\"font\",\"fontWeight\",\"fontColor\",\"fontSize\",\"enabled\",\"visible\",\"fontEff