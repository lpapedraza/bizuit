":null,\"timeMaxValue\":null,\"dateTimeMinValueIncluded\":false,\"dateTimeMaxValueIncluded\":false,\"dateTimeMinValueRelativeIncluded\":false,\"dateTimeMaxValueRelativeIncluded\":true,\"dateTimeMinValueRelativeOperation\":\"Add\",\"dateTimeMaxValueRelativeOperation\":\"Subtract\",\"dateTimeMinValueRelativePeriod\":\"Days\",\"dateTimeMaxValueRelativePeriod\":\"Days\",\"dateTimeMinValueRelativeValue\":0,\"dateTimeMaxValueRelativeValue\":1,\"dateTimeMinPanel\":false,\"dateTimeMaxPanel\":false,\"minRows\":1,\"maxRows\":5,\"dataTypeBooleanControl\":\"String\",\"checkValue\":\"true\",\"uncheckValue\":\"false\",\"dateTimeValueType\":\"EmptyValue\",\"dateTimeValueRelativeOperation\":\"Subtract\",\"dateTimeValueRelativePeriod\":\"Days\",\"dateTimeValueRelativeValue\":0,\"datePickerValue\":\"2026-03-20T03:15:52.109Z\",\"format\":\"Short\",\"customFormat\":\"YYYY-MM-DD\",\"properties\":[\"required\",\"dateTimeMinValueType\",\"dateTimeMaxValueType\",\"dateTimeMinValue\",\"dateTimeMaxValue\",\"timeMinValue\",\"timeMaxValue\",\"dateTimeMinValueIncluded\",\"dateTimeMaxValueIncluded\",\"dateTimeMinValueRelativeIncluded\",\"dateTimeMaxValueRelativeIncluded\",\"dateTimeMinValueRelativeOperation\",\"dateTimeMaxValueRelativeOperation\",\"dateTimeMinValueRelativePeriod\",\"dateTimeMaxValueRelativePeriod\",\"dateTimeMinValueRelativeValue\",\"dateTimeMaxValueRelativeValue\",\"dateTimeMinPanel\",\"dateTimeMaxPanel\",\"dateTimeMinValueRelativeSource\",\"dateTimeMaxValueRelativeSource\",\"dateTimeMinValueRelativeControlName\",\"dateTimeMaxValueRelativeControlName\",\"datePickerValue\",\"format\",\"customFormat\",\"dateTimeNullValue\"],\"regexPattern\":\"\",\"dateTimeMinValueRelativeSource\":\"TODAY\",\"dateTimeMaxValueRelativeSource\":\"CONTROL\",\"dateTimeMinValueRelativeControlName\":\"\",\"dateTimeMaxValueRelativeControlName\":\"fechaNacimiento\"},{\"class\":\"ValidationsPropertiesComponent\",\"title\":\"PROPERTIES.VALIDATIONS.TITLE\",\"match\":\"ANY\",\"errorMessage\":\"\",\"rules\":[]},{\"class\":\"FormattingPropertiesComponent\",\"title\":\"PROPERTIES.FORMATTING.TITLE\",\"rules\":[]},{\"class\":\"CustomCodePropertiesComponent\",\"events\":[{\"_apiName\":\"\",\"_formName\":\"\",\"_eventType\":4,\"_code\":\"const validarFechas = async () =&gt; {\\r\\n\\r\\n    const ctlFechaNacimiento = BizuitForm.controls['fechaNacimiento'];\\r\\n    const ctlFechaExpedicion = BizuitForm.controls['fechaExpedicion'];\\r\\n\\r\\n    // Función auxiliar para parsear fecha en DD/MM/YYYY o ISO\\r\\n    const parsearFecha = (valor) =&gt; {\\r\\n        if (!valor) return null;\\r\\n        if (typeof valor === 'string' &amp;&amp; valor.includes('/')) {\\r\\n            const [day, month, year] = valor.split('/');\\r\\n            const isoFecha = `${year}-${month}-${day}T00:00:00`;\\r\\n            console.log('iso generado:', isoFecha);\\r\\n            return new Date(isoFecha);\\r\\n        }\\r\\n        return new Date(valor);\\r\\n    };\\r\\n\\r\\n    try {\\r\\n        const vlNac = await ctlFechaNacimiento.value;\\r\\n        const vlExp = await ctlFechaExpedicion.value;\\r\\n\\r\\n        console.log('valor original nacimiento:', vlNac);\\r\\n        console.log('valor original expedicion:', vlExp);\\r\\n\\r\\n        const hoy = new Date();\\r\\n        hoy.setHours(0, 0, 0, 0);\\r\\n\\r\\n        // ── Validar fecha de nacimiento ──────────────────────────────\\r\\n        if (vlNac) {\\r\\n            const fechaNac = parsearFecha(vlNac);\\r\\n            fechaNac.setHours(0, 0, 0, 0);\\r\\n            console.log('fechaNac parseada:', fechaNac);\\r\\n\\r\\n            if (fechaNac &gt; hoy) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de nacimiento no puede ser futura',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaNacimiento.value = null;\\r\\n                return; // detener si ya hay error\\r\\n            }\\r\\n        }\\r\\n\\r\\n        // ── Validar fecha de expedición ──────────────────────────────\\r\\n        if (vlExp) {\\r\\n            const fechaExp = parsearFecha(vlExp);\\r\\n            fechaExp.setHours(0, 0, 0, 0);\\r\\n            console.log('fechaExp parseada:', fechaExp);\\r\\n\\r\\n            if (fechaExp &gt; hoy) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de expedición no puede ser futura',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaExpedicion.value = null;\\r\\n                return; // detener si ya hay error\\r\\n            }\\r\\n        }\\r\\n\\r\\n        // ── Validar que nacimiento sea anterior a expedición ─────────\\r\\n        if (vlNac &amp;&amp; vlExp) {\\r\\n            const fechaNac = parsearFecha(vlNac);\\r\\n            const fechaExp = parsearFecha(vlExp);\\r\\n            fechaNac.setHours(0, 0, 0, 0);\\r\\n            fechaExp.setHours(0, 0, 0, 0);\\r\\n\\r\\n            if (fechaNac &gt;= fechaExp) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de nacimiento debe ser anterior a la fecha de expedición',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaExpedicion.value = null;\\r\\n            }\\r\\n        }\\r\\n\\r\\n    } catch (error) {\\r\\n        console.error('Error en validación:', error);\\r\\n    }\\r\\n};\\r\\n\\r\\nvalidarFechas();\"}],\"focusOn\":null,\"basicEvent\":1,\"selectedSecondaryDatasources\":[],\"selectedSecondaryDatasource\":\"\",\"selectedColumnTrace\":0,\"executeValidation\":true,\"selectedSubForm\":\"\",\"subFormSize\":{\"width\":60,\"widthUnit\":\"percentage\",\"height\":60,\"heightUnit\":\"percentage\"},\"addDocumentsTo