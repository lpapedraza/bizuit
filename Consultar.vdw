      <Design>{"id":1049,"name":"form-prueba","controls":"[{\"name\":\"form-prueba\",\"component\":\"MainFormComponent\",\"x\":0,\"y\":0,\"rows\":0,\"cols\":0,\"props\":[{\"class\":\"BasicPropertiesComponent\",\"name\":\"form-prueba\",\"title\":\"PROPERTIES.BASIC.TITLE\",\"label\":\"form-prueba\",\"value\":\"\",\"tooltip\":\"\",\"tooltipPosition\":\"above\",\"font\":\"Quicksand\",\"align\":\"center-container\",\"fontWeight\":\"normal\",\"fontColor\":\"#000000\",\"backgroundColor\":\"#ffffff\",\"fontSize\":12,\"enabled\":true,\"parentEnabled\":true,\"visible\":true,\"vertical\":false,\"fontEffectLineThrough\":false,\"fontEffectUnderline\":false,\"properties\":[\"backgroundColor\"],\"labelValue\":\"value\",\"layer\":1,\"validateOnHiddenControl\":false,\"isSubForm\":false,\"isMainForm\":true},{\"class\":\"FormPropertiesComponent\",\"title\":\"PROPERTIES.FORM.TITLE\",\"showMessageOnSuccess\":true,\"messagesParametersOnSuccess\":[],\"messageOnSuccess\":\"La operación se completó con éxito.\",\"showMessageOnError\":true,\"messageOnError\":\"Ha ocurrido un error.\",\"closeOnSuccess\":true,\"controlType\":\"fill\",\"cols\":6,\"rowHeight\":70,\"themeUseDefaultSettings\":false,\"theme\":\"theme-blue\",\"modalType\":\"swal\",\"modalTitle\":\"\",\"modalUseOKButton\":true,\"modalUseTimer\":false,\"modalUseDefaultSettings\":false,\"modalTimeout\":0,\"useRaiseEventAsync\":false,\"processingWaitTime\":5,\"useOpenFormSettings\":true,\"openFormType\":\"DIALOG\",\"splitType\":\"NONE\",\"formSize\":\"FULL\",\"showModalTitle\":false},{\"class\":\"CustomCodePropertiesComponent\",\"events\":[{\"_apiName\":\"\",\"_formName\":\"\",\"_eventType\":5,\"_code\":\"\\r\\n\\r\\n/*\\r\\nconst validarFechas = async () =&gt; {\\r\\n\\r\\n    const ctlFechaNacimiento = BizuitForm.controls['fechaNacimiento'];\\r\\n    const ctlFechaExpedicion = BizuitForm.controls['fechaExpedicion'];\\r\\n\\r\\n    // Función auxiliar para parsear fecha en DD/MM/YYYY o ISO\\r\\n    const parsearFecha = (valor) =&gt; {\\r\\n        if (!valor) return null;\\r\\n        if (typeof valor === 'string' &amp;&amp; valor.includes('/')) {\\r\\n            const [day, month, year] = valor.split('/');\\r\\n            const isoFecha = `${year}-${month}-${day}T00:00:00`;\\r\\n            console.log('iso generado:', isoFecha);\\r\\n            return new Date(isoFecha);\\r\\n        }\\r\\n        return new Date(valor);\\r\\n    };\\r\\n\\r\\n    try {\\r\\n        const vlNac = await ctlFechaNacimiento.value;\\r\\n        const vlExp = await ctlFechaExpedicion.value;\\r\\n\\r\\n        console.log('valor original nacimiento:', vlNac);\\r\\n        console.log('valor original expedicion:', vlExp);\\r\\n\\r\\n        const hoy = new Date();\\r\\n        hoy.setHours(0, 0, 0, 0);\\r\\n\\r\\n        // ── Validar fecha de nacimiento ──────────────────────────────\\r\\n        if (vlNac) {\\r\\n            const fechaNac = parsearFecha(vlNac);\\r\\n            fechaNac.setHours(0, 0, 0, 0);\\r\\n            console.log('fechaNac parseada:', fechaNac);\\r\\n\\r\\n            if (fechaNac &gt; hoy) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de nacimiento no puede ser futura',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaNacimiento.value = null;\\r\\n                return; // detener si ya hay error\\r\\n            }\\r\\n        }\\r\\n\\r\\n        // ── Validar fecha de expedición ──────────────────────────────\\r\\n        if (vlExp) {\\r\\n            const fechaExp = parsearFecha(vlExp);\\r\\n            fechaExp.setHours(0, 0, 0, 0);\\r\\n            console.log('fechaExp parseada:', fechaExp);\\r\\n\\r\\n            if (fechaExp &gt; hoy) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de expedición no puede ser futura',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaExpedicion.value = null;\\r\\n                return; // detener si ya hay error\\r\\n            }\\r\\n        }\\r\\n\\r\\n        // ── Validar que nacimiento sea anterior a expedición ─────────\\r\\n        if (vlNac &amp;&amp; vlExp) {\\r\\n            const fechaNac = parsearFecha(vlNac);\\r\\n            const fechaExp = parsearFecha(vlExp);\\r\\n            fechaNac.setHours(0, 0, 0, 0);\\r\\n            fechaExp.setHours(0, 0, 0, 0);\\r\\n\\r\\n            if (fechaNac &gt;= fechaExp) {\\r\\n                showAlert({\\r\\n                    icon: 'error',\\r\\n                    title: '¡Error!',\\r\\n                    text: 'La fecha de nacimiento debe ser anterior a la fecha de expedición',\\r\\n                    confirmButtonText: 'Cerrar'\\r\\n                });\\r\\n                ctlFechaExpedicion.value = null;\\r\\n            }\\r\\n        }\\r\\n\\r\\n    } catch (error) {\\r\\n        console.error('Error en validación:', error);\\r\\n    }\\r\\n};\\r\\n\\r\\nvalidarFechas();\\r\\nawait BizuitForm.obtnerUrl();\\r\\n*/\\r\\n\\r\\ntry {\\r\\n    window.addEventListener('message', function(event) {\\r\\n        // Imprime en la consola del navegador para verificar\\r\\n        console.log(\\\"Mensaje recibido desde el iframe:\\\", event.data);\\r\\n        \\r\\n        if (event.data === 'accion_cerrar') {\\r\\n            BizuitForm.close();\\r\\n        }\\r\\n    });\\r\\n} catch (error) {\\r\\n    console.error(\\\"El sandbox de BIZUIT restringió el acceso a window.addEventListener:\\\", error);\\r\\n}\\r\\n\\r\\n\\r\\n/*\\r\\n\\r\\n(function () {\\r\\n\\r\\n    console.log('[BIZUIT PADRE] Registrando listener diagnóstico');\\r\\n\\r\\n    if (window.__listenerDiagnosticoPadre) {\\r\\n        window.removeEventListener('message', window.__listenerDiagnosticoPadre);\\r\\n    }\\r\\n\\r\\n    window.__listenerDiagnosticoPadre = function (event) {\\r\\n        console.log('[BIZUIT PADRE] MESSAGE RECIBIDO:', {\\r\\n            origin: event.origin,\\r\\n            data: event.data\\r\\n        });\\r\\n    };\\r\\n\\r\\n    window.addEventListener('message', window.__listenerDiagnosticoPadre);\\r\\n\\r\\n})();\\r\\n*/\"}],\"focusOn\":null,\"basicEvent\":1,\"selectedSecondaryDatasources\":[],\"selectedSecondaryDatasource\":\"\",\"selectedColumnTrace\":0,\"executeValidation\":true,\"selectedSubForm\":\"\",\"subFormSize\":{\"width\":60,\"widthUnit\":\"percentage\",\"height\":60,\"heightUnit\":\"percentage\"},\"addDocumentsToDataSource\":false,\"selectedDocumentControl\":\"\",\"modalType\":\"swal\",\"modalTitle\":\"\",\"modalMessage\":\"\",\"modalUseOKButton\":true,\"modalUseTimer\":false,\"modalTimeout\":5,\"showMessageOnSuccess\":true,\"clearControlsAfterExecute\":false},{\"class\":\"CustomStylesPropertiesComponent\",\"cssCode\":\"\\r\\n#form-prueba{\\r\\noverflow-x: visible !important;\\r\\n}\\r\\n\\r\\n/*scroll*/\\r\\n/* ===== SCROLL DELGADO GLOBAL (Chrome, Edge, Safari) ===== */\\r\\n::-webkit-scrollbar {\\r\\n  width: 3px;\\r\\n  height: 3px;\\r\\n}\\r\\n\\r\\n::-webkit-scrollbar-track {\\r\\n  background: transparent;\\r\\n}\\r\\n\\r\\n::-webkit-scrollbar-thumb {\\r\\n  background: #888;\\r\\n  border-radius: 3px;\\r\\n}\\r\\n\\r\\n::-webkit-scrollbar-thumb:hover {\\r\\n  background: #555;\\r\\n}\\r\\n\\r\\n/* ===== SCROLL DELGADO PARA FIREFOX ===== */\\r\\n* {\\r\\n  scrollbar-width: thin;\\r\\n  scrollbar-color: #888 transparent;\\r\\n}\\r\\n#containerBotones{\\r\\nbox-sizing: border-box !important;\\r\\noverflow: hidden\\r\\n}\\r\\n.mat-form-field-infix {\\r\\n        border-top: 0 !important;\\r\\n}\\r\\n\\r\\n/* ===== OPCIONAL: SOLO PARA CONTENEDORES CON SCROLL ===== */\\r\\n.mi-contenedor {\\r\\n  overflow: auto;\\r\\n  scrollbar-width: thin;\\r\\n  scrollbar-color: #888 transparent;\\r\\n}\\r\\n\\r\\n.mi-contenedor::-webkit-scrollbar {\\r\\n  width: 3px;\\r\\n  height: 3px;\\r\\n}\\r\\n\\r\\n.mi-contenedor::-webkit-scrollbar-track {\\r\\n  background: transparent;\\r\\n}\\r\\n\\r\\n.mi-contenedor::-webkit-scrollbar-thumb {\\r\\n  background: #888;\\r\\n  border-radius: 10px;\\r\\n}\\r\\n\\r\\n.mi-contenedor::-webkit-scrollbar-thumb:hover {\\r\\n  background: #555;\\r\\n}\\r\\n\\r\\n\\r\\n/* =========================================================\\r\\n   BIZUIT — ESTILO PILL UNIFICADO (SIN CAMBIAR TAMAÑOS)\\r\\n   Compatible con Input, Select, Textarea y DatePicker\\r\\n   ========================================================= */\\r\\n\\r\\n/* ===== CONTENEDOR PRINCIPAL ===== */\\r\\n\\r\\n.mat-form-field-appearance-fill.mat-form-field-can-float.mat-form-field-should-float .mat-form-field-label, .mat-form-field-appearance-fill.mat-form-field-can-float .mat-input-server:focus+.mat-form-field-label-wrapper .mat-form-field-label {\\r\\n    transform: translateY(-1.5em) scale(1) !important;\\r\\n    width: 133.3333333333%;\\r\\n}\\r\\n.mat-form-field-appearance-legacy.mat-form-field-can-float.mat-form-field-should-float .mat-form-field-label, .mat-form-field-appearance-legacy.mat-form-field-can-float .mat-input-server:focus+.mat-form-field-label-wrapper .mat-form-field-label {\\r\\n    transform: translateY(-2.1em) scale(1) perspective(100px) translateZ(.001px) !important;\\r\\n    width: 133.3333333333%;\\r\\n}\\r\\n.mat-form-field-wrapper {\\r\\n    padding-bottom: 0!important; \\r\\n    overflow:visible !important;\\r\\n    padding-top: 15px !important;\\r\\n}\\r\\n.mat-form-field-label-wrapper {\\r\\n  overflow: visible !important;\\r\\n}\\r\\n .mat-form-field-appearance-fill .mat-form-field-flex,\\r\\n .mat-form-field-flex {\\r\\n    background: #eceeef !important;\\r\\n    border-radius: 28px !important;\\r\\n    border: 3px solid transparent !important;\\r\\n    box-sizing: border-box;\\r\\n    transition: all .2s ease;\\r\\n       padding: 0.35em .75em 0 .75em !important;\\r\\n \\r\\n}\\r\\ntextarea.mat-input-element, textarea {\\r\\n    border-radius: 0px !important;\\r\\n}\\r\\ntextarea.mat-input-element.cdk-textarea-autosize {\\r\\n    resize: vertical;\\r\\n    padding-left: 8px;\\r\\n}\\r\\n\\r\\n.mat-form-field-infix ,\\r\\n.mat-form-field-label-wrapper\\r\\n{\\r\\n    left: 2px;;\\r\\n}\\r\\n\\r\\nform-text-area .mat-form-field-label-wrapper{\\r\\n    left: 4px;\\r\\n}\\r\\n/* Hover */\\r\\n\\r\\n .mat-form-field-flex:hover {\\r\\n    border: 2px solid #117499 !important;\\r\\n    background: #f3f6f9 !important;\\r\\n}\\r\\n\\r\\n/* Focus */\\r\\n\\r\\n .mat-form-field.mat-focused .mat-form-field-flex {\\r\\n    border: 2px solid #2167ae !important;\\r\\n    background: #ffffff !important;\\r\\n}\\r\\n\\r\\n/* Quitar underline Material */\\r\\n\\r\\n.mat-form-field-underline {\\r\\n    display: none !important;\\r\\n}\\r\\n\\r\\n/* Label */\\r\\n\\r\\n .mat-form-field-label {\\r\\n    color: #2167ae !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   INPUTS\\r\\n   ========================================================= */\\r\\n\\r\\n input.mat-input-element {\\r\\n    background: transparent !important;\\r\\n    border: none !important;\\r\\n    outline: none !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   TEXTAREA — CORRECTO EN BIZUIT\\r\\n   ========================================================= */\\r\\n\\r\\n/* Contenedor del textarea */\\r\\n\\r\\nform-text-area .mat-form-field-flex,\\r\\ntextarea {\\r\\n    background: #eceeef !important;\\r\\n    border-radius: 28px !important;\\r\\n    border: 2px solid transparent !important;\\r\\n}\\r\\n\\r\\n/* Hover textarea */\\r\\n\\r\\n form-text-area .mat-form-field-flex:hover {\\r\\n    border: 2px solid #117499 !important;\\r\\n}\\r\\n\\r\\n/* Focus textarea */\\r\\n\\r\\n form-text-area .mat-form-field.mat-focused .mat-form-field-flex {\\r\\n    border: 2px solid #2167ae !important;\\r\\n    background: #ffffff !important;\\r\\n}\\r\\n\\r\\n/* Quitar fondo interno blanco */\\r\\n\\r\\n textarea.mat-input-element,\\r\\n textarea {\\r\\n    background: transparent !important;\\r\\n    border: none !important;\\r\\n    outline: none !important;\\r\\n    box-shadow: none !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   DATEPICKER — CONTROL COMPLETO\\r\\n   ========================================================= */\\r\\n\\r\\n/* Contenedor */\\r\\n\\r\\n form-date-picker .mat-form-field-flex,\\r\\n .mat-datepicker-toggle {\\r\\n    background: #eceeef !important;\\r\\n    border-radius: 28px !important;\\r\\n}\\r\\n\\r\\n/* Hover */\\r\\n\\r\\n form-date-picker .mat-form-field-flex:hover {\\r\\n    border: 2px solid #117499 !important;\\r\\n}\\r\\n\\r\\n/* Focus */\\r\\n\\r\\n form-date-picker .mat-form-field.mat-focused .mat-form-field-flex {\\r\\n    border: 2px solid #2167ae !important;\\r\\n    background: #ffffff !important;\\r\\n}\\r\\n\\r\\n/* Input datepicker */\\r\\n\\r\\n form-date-picker input {\\r\\n    background: transparent !important;\\r\\n    border: none !important;\\r\\n}\\r\\n\\r\\n/* Iconos */\\r\\n\\r\\n .mat-datepicker-toggle,\\r\\n .mat-form-field-suffix .mat-icon-button {\\r\\n    color: #2167ae !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   SELECT (COMBOBOX)\\r\\n   ========================================================= */\\r\\n\\r\\n .mat-select-trigger {\\r\\n    background: transparent !important;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   DISABLED\\r\\n   ========================================================= */\\r\\n\\r\\n .mat-form-field.mat-form-field-disabled .mat-form-field-flex,\\r\\n textarea:disabled,\\r\\n input:disabled {\\r\\n    background: #e0e0e0 !important;\\r\\n    border: 2px solid #e0e0e0 !important;\\r\\n    opacity: 0.9;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   PLACEHOLDER\\r\\n   ========================================================= */\\r\\n\\r\\n input::placeholder,\\r\\n textarea::placeholder {\\r\\n    color: #9aa7b3;\\r\\n}\\r\\n\\r\\n/* =========================================================\\r\\n   BUTOONS\\r\\n   ========================================================= */\\r\\n\\r\\n#BtnGuardar { background:#2167AE !important; color:#fff !important; border-radius:999px !important; border:2px solid transparent !important; }\\r\\n#BtnGuardar:hover { background:#4F5E8C !important; }\\r\\n#BtnGuardar:focus { box-shadow:0 0 0 2px #2167AE, 0 0 0 5px rgba(47,108,171,.35) !important; }\\r\\n#BtnGuardar:active { background:#23366F !important; transform:translateY(1px); }\\r\\n#BtnGuardar:disabled { background:#cfd3d6 !important; color:#9aa0a6 !important; }\\r\\n\\r\\n#BtnCancelar { background:transparent !important; color:#2f6cab !important; border:2px solid #2f6cab !important; border-radius:999px !important; }\\r\\n#BtnCancelar:hover { color:#6aa9de !important; border-color:#6aa9de !important; background:rgba(106,169,222,.10) !important; }\\r\\n#BtnCancelar:focus { box-shadow:0 0 0 2px #1f2f5c, 0 0 0 5px rgba(47,108,171,.25) !important; }\\r\\n#BtnCancelar:active { color:#1f2f5c !important; border-color:#1f2f5c !important; background:rgba(31,47,92,.10) !important; transform:translateY(1px); }\\r\\n#BtnCancelar:disabled { color:#c4c7cc !important; border-color:#d6d9dd !important; }\\r\\n\\r\\n#Inactivo:disabled {\\r\\n     border-radius:999px !important; border:2px solid transparent !important;\\r\\n    background-color: #a6adaf !important;\\r\\n    \\r\\n  }\\r\\n\\r\\n\\r\\n.theme-blue .mat-raised-button.mat-primary.mat-button-disabled span span,\\r\\n .theme-blue.mat-raised-button.mat-button-disabled.mat-button-disabled span span {\\r\\ncolor:#2b2e31 !important;\\r\\n}\\r\\n\"}],\"children\":[{\"name\":\"Header1\",\"component\":\"HeaderComponent\",\"x\":0,\"y\":0,\"rows\":1,\"cols\":6,\"pr